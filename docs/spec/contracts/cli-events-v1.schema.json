{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pactrun CLI Events V1",
  "type": "object",
  "required": ["format", "sequence", "received_at_unix_ms", "command", "type"],
  "properties": {
    "format": {"const": "pactrun.cli.events.v1"},
    "sequence": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "received_at_unix_ms": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}]},
    "command": {"type": ["string", "null"]}
  },
  "oneOf": [
    {"$ref": "cli-json-v1.schema.json#/$defs/Record"},
    {
      "type": "object",
      "required": ["type", "response"],
      "properties": {
        "type": {"const": "result"},
        "response": {"$ref": "cli-json-v1.schema.json"}
      }
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "output"}}},
      "then": {"properties": {
        "encoding": {"const": "base64"},
        "offset": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "byte_length": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "data": {"type": "string", "maxLength": 87384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }}
    }
  ]
}
