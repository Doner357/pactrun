{
  "name": "@pactrun/website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node scripts/prepare-text.mjs && docusaurus start",
    "build": "pnpm test:docs && node scripts/prepare-text.mjs && docusaurus build",
    "test:docs": "node --test scripts/text-docs.test.mjs scripts/spec-docs.test.mjs scripts/catalog.test.mjs scripts/tutorial-setup.test.mjs scripts/role-reading.test.mjs scripts/reader-transform.test.mjs scripts/reading-order.test.mjs scripts/versioning.test.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "docs:version": "node scripts/snapshot-version.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.21.0"
}
