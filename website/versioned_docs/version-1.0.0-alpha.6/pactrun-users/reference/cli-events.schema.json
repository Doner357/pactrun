{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pactrun CLI Events 1.0-alpha.3",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "sequence",
    "received_at_unix_ms",
    "command",
    "type"
  ],
  "properties": {
    "format": {
      "const": "pactrun.cli"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "received_at_unix_ms": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      ]
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "format_version": {
      "const": "1.0-alpha.3"
    }
  },
  "oneOf": [
    {
      "$ref": "cli-machine.schema.json#/$defs/Record"
    },
    {
      "type": "object",
      "required": [
        "type",
        "response"
      ],
      "properties": {
        "type": {
          "const": "result"
        },
        "response": {
          "$ref": "cli-machine.schema.json"
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "output"
          }
        }
      },
      "then": {
        "properties": {
          "encoding": {
            "const": "base64"
          },
          "offset": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "byte_length": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "data": {
            "type": "string",
            "maxLength": 87384,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      }
    }
  ]
}
